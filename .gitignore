# ATENÇÃO: o Git não aceita comentário no final da linha de um padrão.
# "backend/local.db  # comentário" vira um padrão literal e não ignora nada.
# Comentários devem ficar sempre em linha separada.

# --- Backend (Python) ---
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/**/*.pyc

# Muito importante: arquivo de senhas
backend/.env
backend/.env.local
backend/.env.production

# Banco de dados SQLite local e temporários do SQLite
backend/local.db
backend/local.db-journal
backend/*.db
backend/*.db-journal

# --- Frontend (Node/React) ---
frontend/node_modules/

# Ignora .env, .env.local, .env.production etc., mas mantém o exemplo
frontend/.env
frontend/.env.*
!frontend/.env.example

# Pasta de build do frontend (gerada por 'npm run build')
frontend/dist/
frontend/build/
frontend/.DS_Store

# --- Arquivos de IDE/Editor ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- Arquivos de Sistema Operacional ---
*.log
.DS_Store
Thumbs.db

# --- Certificados e chaves ---
*.pem
*.key
*.crt

# --- Dados sensíveis ---
credentials.json
secrets.json
